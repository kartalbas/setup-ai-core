#!/usr/bin/env bash
# The ai-core command. It lives in bin/ of the setup-ai-core clone and runs the scripts next to
# it: `ai-core <name>` runs bin/<name>.sh with the remaining arguments, in the current directory.
#
#   ai-core <command> [arguments]
#
set -euo pipefail

CORE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  echo "Usage: ai-core <command> [arguments]"
  echo ""
  echo "Every command takes --help. The machine and the checkouts:"
  echo "  install, doctor, init, push, update, version"
  echo "Inside a repository:"
  echo "  session-start, rules-check, solution-path"
  echo ""
  echo "Commands, from $CORE/bin:"
  for f in "$CORE"/bin/*.sh; do
    f="$(basename "$f" .sh)"
    echo "  $f"
  done
  echo "  version                    Print the setup-ai-core version"
  echo "  help                       Show this help message"
}

# With TRACKER=forgejo the issue commands run in Node, from lib/forgejo/tracker/cli.mts, and the board commands do
# not exist. These two lists are the commands of that treatment; tests/sections/16-forgejo.sh holds them equal to
# the ones cli.mts knows.
FORGEJO_NODE_COMMANDS=" issue-new issue-comment issue-close issue-reopen issue-edit issue-label issue-package issue-priority issue-status issue-assign issue-block issue-unblock issue-thread issue-mine start-issue integrate-issue finish-issue issue-release issue-proof status labels-sync "
FORGEJO_REFUSED_COMMANDS=" board-list board-order board-sync board-unarchive field-option-add item-move item-top project-new repo-boards repo-link view-filter epics-top subissue-add subissue-remove status-sync issue-transfer issue-duplicate issue-map incident-count "

# tracker_of_project: the tracker the project names, as every command reads it
tracker_of_project() { ( . "$CORE/lib/common.sh"; config_value TRACKER github | tr '[:upper:]' '[:lower:]' ); }

command="${1:-help}"
[ $# -gt 0 ] && shift

case "$command" in
  version) tr -d '\r\n' < "$CORE/VERSION"; echo ;;
  help|-h|--help) usage ;;
  *)
    case "$FORGEJO_NODE_COMMANDS$FORGEJO_REFUSED_COMMANDS" in
      *" $command "*)
        if [ "$(tracker_of_project)" = forgejo ]; then
          rc=0; ( . "$CORE/lib/common.sh"; forgejo_tracker_exec "$command" "$@" ) || rc=$?
          exit "$rc"
        fi ;;
    esac
    if [ -f "$CORE/bin/$command.sh" ]; then
      # Every command takes --help: a script that answers it itself runs; any other shows the
      # comment it opens with, which is its usage
      case "${1:-}" in
        -h|--help)
          grep -qF -e '-h|--help)' -e '"--help"' "$CORE/bin/$command.sh" \
            || { awk 'NR == 1 && /^#!/ { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$CORE/bin/$command.sh"; exit 0; } ;;
      esac
      exec bash "$CORE/bin/$command.sh" "$@"
    fi
    echo "error: unknown command '$command'" >&2; usage >&2; exit 1 ;;
esac
