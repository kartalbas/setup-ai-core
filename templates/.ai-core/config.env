# .ai-core/config.env
# Project-specific settings for setup-ai-core. Not tracked by git.

# THE AGENTS THIS PROJECT SERVES, separated by spaces. init deploys the pointer file of each one
# named here and no other.
# Known names: claude, codex, antigravity, openhands, gemini, cursor, windsurf, copilot.
# Empty: every pointer file.
AGENTS="claude codex antigravity openhands"

# Whether session-start asks the origins for releases and new commits (ai-core update --check):
# "session-start" (default) or "never". Nothing is updated by that; the answer is a line.
UPDATE_CHECK="session-start"

# The map (ai-core map): the agent CLI that writes it, claude, codex or agy, and its model when
# not the CLI's default. AI_CORE_MAP_TOOL in the environment names the CLI of one machine instead.
MAP_TOOL="claude"
MAP_MODEL=""

# THE USAGE LIMIT, in percent of any of the account's usage windows. At it every session finishes the
# step in hand and waits for the reset; `ai-core usage` exits 3 there. 92 when unset.
USAGE_STOP_AT="92"
