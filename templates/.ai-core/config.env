# .ai-core/config.env
# Project-specific settings for setup-ai-core. Not tracked by git.

# THE AGENTS THIS PROJECT SERVES, separated by spaces. init deploys the pointer file of each one
# named here and no other, and Graft is wired into these and no other (graft init --agents).
# Known names: claude, codex, antigravity, openhands, gemini, cursor, windsurf, copilot.
# Empty: every agent Graft detects on the machine, and every pointer file.
AGENTS="claude codex antigravity openhands"

# GRAFT CODE INTELLIGENCE
# native : build the code graph with the Node.js on this machine (npx, the Graft version setup-ai-core pins).
#          There is no fallback: without Node.js the setup fails.
# skip   : do not build the code graph in this repository.
GRAFT_EXECUTION_MODE="native"

# Whether session-start asks the origins for releases and new commits (ai-core update --check):
# "session-start" (default) or "never". Nothing is updated by that; the answer is a line.
UPDATE_CHECK="session-start"

# The map (ai-core map): the agent CLI that writes it, claude, codex or agy, and its model when
# not the CLI's default. AI_CORE_MAP_TOOL in the environment names the CLI of one machine instead.
MAP_TOOL="claude"
MAP_MODEL=""

# THE USAGE LIMIT, in percent of any of the account's usage windows. At it every session finishes the
# step in hand and waits for the reset; `ai-core usage` exits 3 there. 92 when unset.
USAGE_STOP_AT="92"

# THE CONTEXT AT WHICH A CLAUDE CODE SESSION COMPACTS, in tokens from 100000 to 1000000, or "auto"
# for the model's own window. Every answer reads the whole context again, so a session that runs
# up to 1M before it compacts reads that much on every turn. init writes it into
# .claude/settings.json as autoCompactWindow; a config.env without the key takes this value.
AUTO_COMPACT_WINDOW="500000"
